<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 laeuft auch auf .NET 9/10 – erst umstellen, wenn CounterStrikeSharp selbst auf .NET 10 laeuft -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>Parachute</AssemblyName>
    <RootNamespace>Parachute</RootNamespace>

    <!-- DLL-Version passend zur ModuleVersion -->
    <Version>1.6.1</Version>
    <Authors>ddbmaster</Authors>
    <Product>CS2 Parachute</Product>

    <!-- sauber fuer CSS-Plugins: keine Fremd-DLLs, keine deps.json, keine PDB -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nimm hier am besten exakt die CSS-API Version die auf deinem Server installiert ist -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.380">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
