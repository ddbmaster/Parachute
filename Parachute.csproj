<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- optional aber sauber für CSS Plugins -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>

    <AssemblyName>Parachute</AssemblyName>
    <RootNamespace>Parachute</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nimm hier am besten exakt die CSS-API Version die auf deinem Server installiert ist -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.358" />
  </ItemGroup>

</Project>
